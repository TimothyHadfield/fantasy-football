{
  "manifest_version": 3,
  "name": "Fantasy Football Bridge",
  "version": "0.2.1",
  "description": "Connects your private ESPN fantasy league to your Fantasy Football site, without making the league public.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://lm-api-reads.fantasy.espn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://timothyhadfield.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content-site.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fantasy Football Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}